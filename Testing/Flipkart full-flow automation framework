### 🧩 ProductPage.cs

```csharp
public class ProductPage
{
    private readonly IPage _page;
    public ProductPage(IPage page) => _page = page;

    public async Task SwitchToProductTab()
    {
        var pages = _page.Context.Pages;
        if (pages.Count > 1)
            await pages[1].BringToFrontAsync();
    }

    public async Task AddToCart()
    {
        var addToCartBtn = _page.Locator("button:has-text('Add to cart')");
        await addToCartBtn.ClickAsync();
    }
}
```

